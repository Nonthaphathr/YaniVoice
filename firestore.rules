rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'nonthaphathr@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /yani11_attempts/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.room is string && request.resource.data.room.size() <= 24
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 100;
      allow read: if isTeacher()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isTeacher();
    }
  }
}
